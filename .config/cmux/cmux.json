{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "shortcuts": {
    "bindings": {
      "openDiffViewer": "none"
    }
  },

  "actions": {
    "diff-split": {
      "type": "command",
      "title": "Hunk Diff in Split",
      "keywords": ["diff", "review"],
      "command": "cmux new-split right --focus true --command \"hunk diff\"; exit",
      "target": "newTabInCurrentPane",
      "shortcut": "cmd+ctrl+shift+d"
    }
  }
}
