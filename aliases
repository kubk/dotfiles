# DeepSeek model names probed against the live API on 2026-09-17. The API's own
# error text names deepseek-flash + deepseek-v4-pro as canonical. deepseek-chat
# and deepseek-reasoner were retired 2026-07-24 and only linger as aliases that
# silently route to v4-flash
# Effort is remapped server-side: low->low, medium->high, high->high,
# xhigh->high, max->max, so only low, high and max are distinct tiers
DEEPSEEK_PRO=deepseek-v4-pro
DEEPSEEK_FLASH=deepseek-flash

_deepseek_env() {
  if [ -f "$HOME/projects/dotfiles/.env" ]; then
    source "$HOME/projects/dotfiles/.env"
  else
    echo "Warning: .env file not found at $HOME/projects/dotfiles/.env"
    return 1
  fi

  if [ -z "$DEEP_SEEK_KEY" ]; then
    echo "Warning: DEEP_SEEK_KEY is not set in $HOME/projects/dotfiles/.env"
    return 1
  fi
}

# DeepSeek-backed Codex. Requires the `[model_providers.deepseek]` block +
# `model_catalog_json` in ~/.codex/config.toml (already wired up). Key is read
# from DEEP_SEEK_KEY via env_key.
# _dsx <model> <effort> [extra codex args...]
_dsx() {
  _deepseek_env || return 1
  local model="$1" effort="$2"
  shift 2

  DEEP_SEEK_KEY="$DEEP_SEEK_KEY" \
  command codex --yolo \
    -m "$model" \
    -c 'model_provider="deepseek"' \
    -c "model_reasoning_effort=\"$effort\"" \
    "$@"
}

dco()  { _dsx "$DEEPSEEK_PRO" max "$@"; }   # smartest — V4 Pro, max effort
dcom() { _dsx "$DEEPSEEK_PRO" high "$@"; }  # medium — V4 Pro, high effort
dcof() { _dsx "$DEEPSEEK_FLASH" low "$@"; } # fast — V4 Flash, low effort
