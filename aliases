# DeepSeek-backed Claude Code
# Model names probed against the live API on 2026-09-17. The API's own error
# text names deepseek-flash + deepseek-v4-pro as canonical. deepseek-chat and
# deepseek-reasoner were retired 2026-07-24 and only linger as aliases that
# silently route to v4-flash
# Effort is remapped server-side: low->low, medium->high, high->high,
# xhigh->high, max->max, so only low, high and max are distinct tiers
DEEPSEEK_PRO=deepseek-v4-pro
DEEPSEEK_FLASH=deepseek-flash

_deepseek_claude_env() {
  if [ -f "$HOME/projects/dotfiles/.env" ]; then
    source "$HOME/projects/dotfiles/.env"
  else
    echo "Warning: .env file not found at $HOME/projects/dotfiles/.env"
    return 1
  fi

  if [ -z "$DEEP_SEEK_KEY" ]; then
    echo "Warning: DEEP_SEEK_KEY is not set in $HOME/projects/dotfiles/.env"
    return 1
  fi
}

# _dsc <model> <effort> [extra claude args...]
_dsc() {
  _deepseek_claude_env || return 1
  local model="$1" effort="$2"
  shift 2

  ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic \
  ANTHROPIC_AUTH_TOKEN="$DEEP_SEEK_KEY" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$model" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$model" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$DEEPSEEK_FLASH" \
  CLAUDE_CODE_SUBAGENT_MODEL="$DEEPSEEK_FLASH" \
  CLAUDE_CODE_EFFORT_LEVEL="$effort" \
  API_TIMEOUT_MS=600000 \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  command claude --dangerously-skip-permissions "$@"
}

cc()  { _dsc "$DEEPSEEK_PRO" max "$@"; }    # smartest — V4 Pro, max effort
ccm() { _dsc "$DEEPSEEK_PRO" high "$@"; }   # medium — V4 Pro, high effort
ccf() { _dsc "$DEEPSEEK_FLASH" low "$@"; }  # fast — V4 Flash, low effort
