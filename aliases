# DeepSeek V4.1 Flash through Vercel AI Gateway
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash

_ai_gateway_env() {
  if [ -f "$HOME/projects/dotfiles/.env" ]; then
    source "$HOME/projects/dotfiles/.env"
  else
    echo "Warning: .env file not found at $HOME/projects/dotfiles/.env"
    return 1
  fi

  if [ -z "$AI_GATEWAY_API_KEY" ]; then
    echo "Warning: AI_GATEWAY_API_KEY is not set in $HOME/projects/dotfiles/.env"
    return 1
  fi
}

# DeepSeek through AI Gateway, using the same Codex CLI and effort settings.
# _dsx <model> <effort> [extra codex args...]
_dsx() {
  _ai_gateway_env || return 1
  local model="$1" effort="$2"
  shift 2

  AI_GATEWAY_API_KEY="$AI_GATEWAY_API_KEY" \
  command codex --yolo \
    -m "$model" \
    -c 'model_provider="vercel"' \
    -c "model_reasoning_effort=\"$effort\"" \
    "$@"
}

gdco()  { _dsx "$DEEPSEEK_MODEL" max "$@"; }  # V4.1 Flash, max effort
gdcom() { _dsx "$DEEPSEEK_MODEL" high "$@"; } # V4.1 Flash, high effort
gdcof() { _dsx "$DEEPSEEK_MODEL" low "$@"; }  # V4.1 Flash, low effort

# DeepSeek through OpenRouter, using the same Codex CLI and effort settings
_openrouter_env() {
  if [ -f "$HOME/projects/dotfiles/.env" ]; then
    source "$HOME/projects/dotfiles/.env"
  else
    echo "Warning: .env file not found at $HOME/projects/dotfiles/.env"
    return 1
  fi

  if [ -z "$OPENROUTER_API_KEY" ]; then
    echo "Warning: OPENROUTER_API_KEY is not set in $HOME/projects/dotfiles/.env"
    return 1
  fi
}

# _orx <model> <effort> [extra codex args...]
_orx() {
  _openrouter_env || return 1
  local model="$1" effort="$2"
  shift 2
  local -a codex_subcommand
  codex_subcommand=()
  if [ "${1-}" = "exec" ]; then
    codex_subcommand=(exec)
    shift
  fi

  OPENROUTER_API_KEY="$OPENROUTER_API_KEY" \
  command codex "${codex_subcommand[@]}" --yolo \
    -m "$model" \
    -c 'model_provider="openrouter"' \
    -c "model_reasoning_effort=\"$effort\"" \
    "$@"
}

dco()  { _orx "$DEEPSEEK_MODEL" max "$@"; }  # V4.1 Flash, max effort
dcom() { _orx "$DEEPSEEK_MODEL" high "$@"; } # V4.1 Flash, high effort
dcof() { _orx "$DEEPSEEK_MODEL" low "$@"; }  # V4.1 Flash, low effort
